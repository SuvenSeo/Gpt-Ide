# Absolute or process-relative path to the repository GPT IDE may access.
WORKSPACE_ROOT=.

# Local server. Use 0.0.0.0 only in a controlled container or host.
HOST=127.0.0.1
PORT=8000

# Comma-separated host names accepted by the MCP server.
# Add your tunnel hostname, for example: random-name.ngrok-free.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to receive CORS responses.
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Optional static bearer token for compatible MCP clients.
# Leave unset for ChatGPT developer-mode testing unless your connection supports it.
API_TOKEN=

# Optional app domain used by ChatGPT's widget sandbox for production/submission.
WIDGET_DOMAIN=

# Executables the terminal tool can start. No shell is used.
COMMAND_ALLOWLIST=npm,pnpm,yarn,npx,node,bun,deno,python,python3,pytest,git,cargo,go,make,cmake,dotnet,java,mvn,gradle

MAX_FILE_BYTES=2097152
MAX_OUTPUT_BYTES=1048576
MAX_COMMAND_TIMEOUT_MS=120000
MAX_CHECKPOINT_BYTES=104857600
MAX_CHECKPOINT_FILES=20000
